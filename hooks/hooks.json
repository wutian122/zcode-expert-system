{
  "description": "ZCode Expert System plugin hooks — 在每次用户输入前注入专家体系自动触发规则。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/prepend-global-rules-reminder.mjs"
            ],
            "timeoutMs": 3000,
            "statusMessage": "zcode-expert-system: 注入专家体系触发规则…"
          }
        ]
      }
    ]
  }
}
# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node / npm
node_modules/
npm-debug.log*

# ZCode plugin runtime / deployment artifacts (not source)
.zcode/
.zcode-*/**/
plugins/
skills/

# Required source artifacts that must be committed
!.zcode-plugin/
!.zcode-plugin/**
!context/context-manager.py
!package-lock.json

# Mimosa runtime artifacts
.mimosa/

# Superpowers runtime artifacts
.superpowers/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test reports (runtime artifacts, not source)
docs/test-reports/

# Internal development plans (not for public consumption)
docs/superpowers/plans/

# Backup files
*.bak-*
*.bak

# Test/probe archive changes
openspec/changes/*-test-archive/
openspec/changes/*-test-probe/

# Local probe / sandbox dirs
/tmp-probe*/
/tmp-wf-test*/
/tmp-x/

# NOTE: context/context-manager.py and package-lock.json are required source
# files and must stay tracked. They are intentionally NOT ignored.
